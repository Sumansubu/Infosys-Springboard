# ==============================================================================
# Multi-Agent Financial Research System - Root Environment Configuration Template
# Copy this file to .env (or Engine/.env) and populate with your production credentials.
# ==============================================================================

# Application Environment ('development' or 'production')
APP_ENV=production
DEBUG=false
PORT=8000

# ------------------------------------------------------------------------------
# Relational Database: Supabase PostgreSQL (Production) / SQLite (Fallback)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=
SQLITE_DB_PATH=documents.db

# ------------------------------------------------------------------------------
# Object Storage: Supabase Storage Bucket ('supabase') / Local Filesystem ('local')
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=financial-documents

# ------------------------------------------------------------------------------
# Vector Database: Qdrant Cloud or Local Container ('qdrant') / ChromaDB ('chroma')
# ------------------------------------------------------------------------------
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=financial_chunks_openai_te3small_v1

# ChromaDB Fallback Directory (Used when VECTOR_STORE_TYPE=chroma or auto-fallback)
CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION=financial_chunks_local_minilm_v1

# ------------------------------------------------------------------------------
# Embeddings Provider: OpenAI ('openai'), Sentence-Transformers ('sentence-transformers'),
# or the dependency-free offline provider ('hashing', 384-dimensional hashed BoW).
# text-embedding-3-small outputs 1536-dimensional vectors
# all-MiniLM-L6-v2 outputs 384-dimensional vectors
# When 'sentence-transformers' is selected but not installed, the system falls back
# to 'hashing' with a warning. Use 'hashing' for CI / air-gapped development.
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# Primary LLM Reasoning Provider: OpenAI ('openai')
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_REASONING_EFFORT=high
OPENAI_ENABLE_PDF_VISION=false

# ------------------------------------------------------------------------------
# Document Chunking & Ingestion Settings
# ------------------------------------------------------------------------------
SEED_DOCS_DIR=seed_documents
MAX_FILE_SIZE=23068672 # 22 MB in bytes
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# ------------------------------------------------------------------------------
# Durable Background Job Worker Settings
# ------------------------------------------------------------------------------
WORKER_POLL_SECONDS=3
WORKER_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api

